{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "routemux-media-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "routemux-images" }],
  "ai": { "binding": "AI" },
  "images": { "binding": "RESIZER" },
  "vars": { "ROUTEMUX_BASE_URL": "https://api.routemux.com/v1" },
  // Off on purpose: invocation logs record the request URL, and the URL carries SECRET.
  "observability": { "enabled": false }
  // Secrets (wrangler secret put): SECRET, ROUTEMUX_KEY.
}
